      "id": "p-stacked-reqs",
      "title": "Requests per Second (Stacked by Service)",
      "panelTypes": "graph",
      "isStacked": true,
      "yAxisUnit": "reqps",
      "nullZeroValues": "zero",
      "opacity": "1",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "dataSource": "metrics",
              "aggregateOperator": "rate",
              "aggregateAttribute": {
                "dataType": "float64",
                "id": "signoz_calls_total--float64--Sum--true",
                "isColumn": true,
                "isJSON": false,
                "key": "signoz_calls_total",
                "type": "Sum"
              },
              "timeAggregation": "rate",
              "spaceAggregation": "sum",
              "groupBy": [
                {
                  "dataType": "string",
                  "id": "service.name--string--tag--false",
                  "isColumn": false,
                  "isJSON": false,
                  "key": "service.name",
                  "type": "tag"
                }
              ],
              "filters": {
                "items": [
                  {
                    "id": "f1",
                    "key": {
                      "dataType": "string",
                      "id": "service.name--string--tag--false",
                      "isColumn": false,
                      "isJSON": false,
                      "key": "service.name",
                      "type": "tag"
                    },
                    "op": "in",
                    "value": [
                      "{{.service_name}}"
                    ]
                  }
                ],
                "op": "AND"
              },
              "legend": "{{service.name}}",
              "stepInterval": 60,
              "disabled": false
            }
          ],
          "queryFormulas": []
        },
        "promql": [
          {
            "disabled": false,
