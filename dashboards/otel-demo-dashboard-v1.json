{
  "description": "Professional multi-service observability overview",
  "tags": [
    "opentelemetry",
    "production",
    "apm"
  ],
  "title": "OpenTelemetry Demo - Overview",
  "version": "v4",
  "variables": {
    "service_name": {
      "allSelected": true,
      "id": "v-service-name",
      "multiSelect": true,
      "name": "service_name",
      "queryValue": "SELECT JSONExtractString(labels, 'service.name') AS `service_name` FROM signoz_metrics.time_series_v4_1day WHERE (metric_name = 'signoz_calls_total') GROUP BY `service_name` ORDER BY `service_name` ASC",
      "showALLOption": true,
      "type": "QUERY"
    }
  },
  "layout": [
    {
      "h": 6,
      "i": "p-stacked-reqs",
      "w": 12,
      "x": 0,
      "y": 0
    },
    {
      "h": 6,
      "i": "p-latency-p99",
      "w": 6,
      "x": 0,
      "y": 6
    },
    {
      "h": 6,
      "i": "p-error-rate",
      "w": 6,
      "x": 6,
      "y": 6
    },
    {
      "h": 6,
      "i": "p-endpoints-table",
      "w": 12,
      "x": 0,
      "y": 12
    },
    {
      "h": 6,
      "i": "p-dice-node",
      "w": 12,
      "x": 0,
      "y": 18
    }
  ],
